---
import '../styles/global.css';
import { createSupabaseServer } from '../lib/supabase';

interface Props {
	title: string;
}

const { title } = Astro.props;
const supabase = createSupabaseServer(Astro);

const { data: { session } } = await supabase.auth.getSession();
let primaryColor = '#00FF94';
let secondaryColor = '#00FF94cc';

if (session) {
  const { data: settings } = await supabase.from('facility_settings').select('primary_color').eq('manager_id', session.user.id).single();
  if (settings?.primary_color) {
    primaryColor = settings.primary_color;
    secondaryColor = primaryColor + 'cc';
  }
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Pickle Scheduler - High Performance Court Booking" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <style is:global define:vars={{ primaryColor, secondaryColor }}>
      :root, html, body {
        --color-brand-primary: var(--primaryColor) !important;
        --color-brand-secondary: var(--secondaryColor) !important;
      }
    </style>
	</head>
	<body>
		<main class="max-w-7xl mx-auto px-4 py-12">
			<slot />
		</main>
	</body>
</html>
