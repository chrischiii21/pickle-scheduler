---
import Layout from '../../layouts/Layout.astro';
import { Calendar, Clock, ChevronRight, CheckCircle2, Loader2, Info } from 'lucide-astro';
import { format, startOfDay, addDays, setHours } from 'date-fns';

// 1. Static Mock Data for Demo
const court = {
  id: 'demo-court',
  name: 'Demo Court (Royal Greens)',
  base_price: 1500.00
};

// 2. Generate static mock bookings
const today = startOfDay(new Date());
const slots = Array.from({ length: 14 }, (_, i) => {
  const time = setHours(today, 8 + i);
  // Randomly book some slots for demo feel
  const isBooked = i === 2 || i === 5 || i === 8;
  
  return {
    time,
    isBooked,
    isPending: false,
  };
});
---

<Layout title="Demo Booking | Pickle Scheduler">
  <div class="max-w-4xl mx-auto">
    <!-- Demo Banner -->
    <div class="bg-brand-secondary/20 border border-brand-secondary/30 rounded-2xl p-4 mb-12 flex items-center gap-4 text-brand-secondary">
      <Info size={24} />
      <p class="text-sm font-medium">
        <strong>Demo Mode:</strong> You are exploring the renter's experience. No real data will be saved to the database.
      </p>
    </div>

    <div class="flex flex-col gap-8">
      <header class="text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
          Live Demo
        </div>
        <h1 class="text-5xl font-bold tracking-tight text-white">{court.name}</h1>
        <p class="text-white/60 text-lg max-w-lg mx-auto">Experience the snappy, logic-driven booking flow that your customers will love.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-6">
          <div class="flex justify-between items-center">
            <h2 class="text-xl font-bold flex items-center gap-2">
              <Calendar size={20} class="text-brand-primary" />
              Select Time Slots
            </h2>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="slot-container">
            {slots.map((slot) => (
              <button
                class={`
                  slot-btn p-4 rounded-2xl border transition-all text-left group relative overflow-hidden
                  ${slot.isBooked 
                    ? 'bg-white/5 border-white/5 opacity-50 cursor-not-allowed booked' 
                    : 'bg-brand-muted border-white/10 hover:border-brand-primary/50 cursor-pointer active:scale-95'}
                `}
                data-time={slot.time.toISOString()}
                disabled={slot.isBooked}
              >
                <div class="flex flex-col">
                  <span class="text-xs text-white/40 font-medium group-hover:text-brand-primary/70 transition-colors">
                    {format(slot.time, 'EEE, MMM d')}
                  </span>
                  <span class="text-lg font-bold mt-1">
                    {format(slot.time, 'h:mm a')}
                  </span>
                </div>
                {!slot.isBooked && (
                  <div class="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <CheckCircle2 size={16} class="text-brand-primary" />
                  </div>
                )}
              </button>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div class="bento-card sticky top-8 border-brand-primary/20 bg-brand-primary/5">
            <h2 class="text-xl font-bold mb-6">Complete Booking</h2>
            
            <form id="booking-form" class="space-y-4">
              <div id="selection-summary" class="bg-white/5 rounded-xl p-4 mb-4 hidden">
                <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-2">Selected Slots</p>
                <ul id="selected-list" class="text-sm space-y-1"></ul>
              </div>

              <div class="space-y-2">
                <label class="text-xs font-bold uppercase tracking-widest text-white/40">Full Name</label>
                <input required type="text" placeholder="John Doe" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:border-brand-primary transition-all" />
              </div>
              
              <div class="space-y-2">
                <label class="text-xs font-bold uppercase tracking-widest text-white/40">Email Address</label>
                <input required type="email" placeholder="john@example.com" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:border-brand-primary transition-all" />
              </div>

              <div class="pt-4 mt-6 border-t border-white/10">
                <div class="flex justify-between items-center mb-4">
                  <span class="text-white/60">Total</span>
                  <span id="total-price" class="text-2xl font-bold">₱0.00</span>
                </div>
                
                <button id="submit-btn" type="submit" disabled class="w-full py-4 bg-white/10 text-white/40 font-bold rounded-xl flex items-center justify-center gap-2 transition-all cursor-not-allowed">
                  Select Slots
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { format } from 'date-fns';

  const slotBtns = document.querySelectorAll('.slot-btn:not(.booked)');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const totalPriceEl = document.getElementById('total-price');
  const selectionSummary = document.getElementById('selection-summary');
  const selectedList = document.getElementById('selected-list');

  const basePrice = 1500;
  let selectedSlots: string[] = [];

  function updateUI() {
    selectedSlots.sort();
    totalPriceEl!.innerText = `₱${(selectedSlots.length * basePrice).toFixed(2)}`;
    
    if (selectedSlots.length > 0) {
      selectionSummary?.classList.remove('hidden');
      selectedList!.innerHTML = selectedSlots.map(s => `<li>${format(new Date(s), 'h:mm a')}</li>`).join('');
      submitBtn.disabled = false;
      submitBtn.classList.remove('bg-white/10', 'text-white/40', 'cursor-not-allowed');
      submitBtn.classList.add('bg-brand-primary', 'text-black', 'hover:bg-brand-primary/90');
      submitBtn.innerText = `Reserve ${selectedSlots.length} Slot${selectedSlots.length > 1 ? 's' : ''}`;
    } else {
      selectionSummary?.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.classList.add('bg-white/10', 'text-white/40', 'cursor-not-allowed');
      submitBtn.innerText = 'Select Slots';
    }
  }

  slotBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const time = btn.getAttribute('data-time')!;
      if (selectedSlots.includes(time)) {
        selectedSlots = selectedSlots.filter(s => s !== time);
        btn.classList.remove('bg-brand-primary', 'text-black', 'border-brand-primary');
        btn.classList.add('bg-brand-muted', 'border-white/10');
      } else {
        selectedSlots.push(time);
        btn.classList.remove('bg-brand-muted', 'border-white/10');
        btn.classList.add('bg-brand-primary', 'text-black', 'border-brand-primary');
      }
      updateUI();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="animate-spin mr-2">◌</span> Creating Demo Booking...';
    
    // Simulate API delay
    await new Promise(r => setTimeout(r, 1500));
    
    // Redirect to a static demo success page or just show an alert
    alert('Demo booking successful! In a real scenario, this would now be synced to your Google Calendar.');
    window.location.href = '/';
  });
</script>
