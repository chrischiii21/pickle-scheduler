---
import Layout from '../../layouts/Layout.astro';
import { Calendar, Clock, ChevronRight, CheckCircle2, Loader2, Plus, AlertTriangle } from 'lucide-astro';
import { format, addHours, startOfDay, isBefore, addDays, setHours, startOfMonth, startOfWeek, isSameMonth } from 'date-fns';
import { supabase } from '../../lib/supabase';

const { id } = Astro.params;

// 1. Fetch real court data
const { data: court, error: courtError } = await supabase
  .from('courts')
  .select('*')
  .eq('id', id)
  .single();

// 2. Handle Date Selection
const dateParam = Astro.url.searchParams.get('date');
const selectedDate = dateParam ? startOfDay(new Date(dateParam)) : startOfDay(new Date());

if (courtError || !court) {
  // Gracefully handled in template
}
---

<Layout title={court ? `Book ${court.name} | Pickle Scheduler` : "Court Not Found"}>
  {!court ? (
    <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
      <div class="w-24 h-24 rounded-3xl bg-red-500/10 flex items-center justify-center text-red-500 mb-8 border border-red-500/20 shadow-2xl shadow-red-500/10">
        <AlertTriangle size={48} />
      </div>
      <h1 class="text-4xl font-bold text-white mb-4">Court Unavailable</h1>
      <p class="text-white/40 max-w-md mx-auto leading-relaxed">
        This booking link has expired or the court has been removed by the facility manager. 
        Please contact the administrator or try a different link.
      </p>
    </div>
  ) : (
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col gap-8">
        <header class="text-center space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
            Available Now
          </div>
          <h1 class="text-5xl font-bold tracking-tight text-white">{court.name}</h1>
          <p class="text-white/60 text-lg max-w-lg mx-auto">Premium pickleball court with professional surfacing and lighting.</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Main Booking Hub -->
          <div class="lg:col-span-8 space-y-6">
            <div class="bento-card bg-white/5 border-white/5 p-0 overflow-hidden flex flex-col md:flex-row">
              <!-- Left: Calendar -->
              <div class="md:w-1/2 p-6 border-b md:border-b-0 md:border-r border-white/5">
                <div class="flex items-center gap-3 mb-6">
                  <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary">
                    <Calendar size={18} />
                  </div>
                  <h3 class="font-bold text-sm uppercase tracking-widest text-white/60">Choose Date</h3>
                </div>

                <div class="space-y-4">
                  <div class="text-center">
                    <h4 class="font-bold text-brand-primary">{format(selectedDate, 'MMMM yyyy')}</h4>
                  </div>
                  
                  <div class="grid grid-cols-7 gap-1">
                    {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map(d => (
                      <div class="text-center text-[8px] font-bold text-white/20 uppercase pb-2">{d}</div>
                    ))}
                    
                    {(() => {
                      const monthStart = startOfMonth(selectedDate);
                      const calendarStart = startOfWeek(monthStart);
                      const calendarDays = Array.from({ length: 35 }).map((_, i) => addDays(calendarStart, i));
                      
                      return calendarDays.map(date => {
                        const isSelected = format(date, 'yyyy-MM-dd') === format(selectedDate, 'yyyy-MM-dd');
                        const isPast = isBefore(date, startOfDay(new Date()));
                        const isCurrentMonth = isSameMonth(date, monthStart);
                        const dateVal = format(date, 'yyyy-MM-dd');
                        
                        return (
                          <button 
                            type="button"
                            data-date={dateVal}
                            disabled={isPast}
                            class={`
                              calendar-day aspect-square flex items-center justify-center rounded-lg text-xs font-bold transition-all
                              ${isPast ? 'opacity-5 cursor-not-allowed' : 'hover:bg-brand-primary/10 hover:text-brand-primary'}
                              ${isSelected ? 'bg-brand-primary text-black selected' : ''}
                              ${!isCurrentMonth && !isSelected ? 'text-white/10' : ''}
                            `}
                          >
                            {format(date, 'd')}
                          </button>
                        );
                      });
                    })()}
                  </div>
                </div>
              </div>

              <!-- Right: Time Slots -->
              <div class="md:w-1/2 p-6 bg-white/[0.02]">
                 <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary">
                        <Clock size={18} />
                      </div>
                      <h3 class="font-bold text-sm uppercase tracking-widest text-white/60">Select Time</h3>
                    </div>
                    
                    <div class="flex bg-white/5 p-1 rounded-xl border border-white/10" id="booking-mode-toggle">
                      <button type="button" data-mode="private" class="mode-btn px-2 py-1 rounded-lg text-[8px] font-bold uppercase transition-all bg-brand-primary text-black">Private</button>
                      <button type="button" data-mode="open" class="mode-btn px-2 py-1 rounded-lg text-[8px] font-bold uppercase transition-all text-white/40 hover:text-white">Open Play</button>
                    </div>
                 </div>

                 <!-- Blackout Notice -->
                 <div id="blackout-notice" class="hidden p-6 bg-red-500/10 border border-red-500/20 rounded-[24px] mb-8 animate-in zoom-in-95 duration-300">
                    <div class="flex items-center gap-4">
                       <div class="w-12 h-12 rounded-2xl bg-red-500/20 flex items-center justify-center text-red-500">
                          <AlertTriangle size={24} />
                       </div>
                       <div>
                          <h4 class="font-bold text-red-400">Restricted Availability</h4>
                          <p id="blackout-reason" class="text-xs text-white/40 mt-0.5">Court is currently closed for maintenance/holiday.</p>
                       </div>
                    </div>
                 </div>

                 <div class="grid grid-cols-2 gap-2 max-h-[350px] overflow-y-auto pr-2 custom-scrollbar" id="slot-container">
                    <!-- Slots will be injected by script -->
                 </div>
              </div>
            </div>
          </div>

          <!-- Sidebar: Summary & Checkout -->
          <div class="lg:col-span-4 space-y-6">
            <div class="bento-card border-brand-primary/20 bg-brand-primary/5 p-6 sticky top-8">
              <h3 class="text-xl font-bold mb-6">Your Booking</h3>
              
              <div id="selection-summary" class="space-y-4 mb-8">
                 <div class="flex items-center justify-between text-xs text-white/40 border-b border-white/5 pb-2">
                    <span>Selected Date</span>
                    <span class="text-white font-bold" id="selected-date-display">{format(selectedDate, 'EEEE, MMM d')}</span>
                 </div>
                 
                 <div class="space-y-2">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-white/20">Selected Slots</p>
                    <div id="selected-list" class="flex flex-wrap gap-2 min-h-[40px]">
                      <p class="text-xs text-white/20 italic">No slots selected yet...</p>
                    </div>
                 </div>

                 <div class="pt-4 border-t border-white/5">
                    <div class="flex justify-between items-center">
                      <span class="text-sm text-white/40">Subtotal</span>
                      <span id="total-price" class="text-xl font-bold">₱0.00</span>
                    </div>
                 </div>
              </div>

              <button id="open-checkout" disabled class="w-full py-4 bg-white/10 text-white/40 font-bold rounded-2xl transition-all flex items-center justify-center gap-2 cursor-not-allowed group">
                Proceed to Checkout
                <ChevronRight size={18} class="group-hover:translate-x-1 transition-transform" />
              </button>
            </div>
          </div>
        </div>

        <!-- Checkout Modal -->
        <div id="checkout-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden animate-in fade-in duration-300">
          <div class="bg-brand-dark border border-white/10 rounded-[32px] w-full max-w-lg p-8 shadow-2xl relative">
            <button id="close-checkout" class="absolute top-6 right-6 text-white/20 hover:text-white transition-colors">
              <Plus class="rotate-45" size={24} />
            </button>

            <div class="text-center mb-8">
              <h2 class="text-2xl font-bold mb-1">Finish Your Booking</h2>
              <p class="text-white/40 text-sm">Enter your details to confirm reservation.</p>
            </div>

            <form id="booking-form" class="space-y-6">
              <input type="hidden" name="court_id" value={court.id} />
              <input type="hidden" name="slots" id="slots-input" />

              <div class="space-y-4">
                <div class="space-y-1">
                  <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Full Name</label>
                  <input required type="text" name="renter_name" placeholder="John Doe" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:border-brand-primary transition-all text-white" />
                </div>
                
                <div class="space-y-1">
                  <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Email Address</label>
                  <input required type="email" name="renter_email" placeholder="john@example.com" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:border-brand-primary transition-all text-white" />
                </div>

                <div id="player-count-field" class="space-y-1 hidden animate-in fade-in slide-in-from-top-1">
                  <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Number of Players</label>
                  <div class="flex items-center gap-4">
                    <input type="number" id="num-players" name="player_count" value="1" min="1" max="10" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:border-brand-primary transition-all text-white" />
                    <p class="text-[10px] text-white/40 italic whitespace-nowrap">Price will be multiplied by players</p>
                  </div>
                </div>
              </div>

              <button id="submit-booking" type="submit" class="w-full py-4 bg-brand-primary text-black font-bold rounded-2xl hover:bg-brand-primary/90 transition-all shadow-lg shadow-brand-primary/20 flex items-center justify-center gap-2">
                Confirm Reservation
              </button>
              <p id="error-message" class="text-xs text-red-400 mt-4 text-center hidden"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  )}
</Layout>

<script>
  import { format } from 'date-fns';

  const courtId = window.location.pathname.split('/').pop();
  let currentSelectedDate = new Date().toISOString().split('T')[0];
  let currentMode = 'private';
  let slots: any[] = [];
  let selectedSlots: any[] = [];

  const slotContainer = document.getElementById('slot-container');
  const blackoutNotice = document.getElementById('blackout-notice');
  const blackoutReason = document.getElementById('blackout-reason');
  const selectedList = document.getElementById('selected-list');
  const totalPriceEl = document.getElementById('total-price');
  const slotsInput = document.getElementById('slots-input') as HTMLInputElement;
  const openCheckoutBtn = document.getElementById('open-checkout') as HTMLButtonElement;
  const modeBtns = document.querySelectorAll('.mode-btn');
  const calendarDays = document.querySelectorAll('.calendar-day');
  const selectedDateDisplay = document.getElementById('selected-date-display');
  
  const modal = document.getElementById('checkout-modal');
  const closeCheckout = document.getElementById('close-checkout');
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-booking') as HTMLButtonElement;
  const errorMsg = document.getElementById('error-message')!;
  const playerCountField = document.getElementById('player-count-field');
  const playersInput = document.getElementById('num-players') as HTMLInputElement;

  // Mode Selection
  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentMode = btn.getAttribute('data-mode')!;
      modeBtns.forEach(b => {
        b.classList.remove('bg-brand-primary', 'text-black');
        b.classList.add('text-white/40');
      });
      btn.classList.add('bg-brand-primary', 'text-black');
      btn.classList.remove('text-white/40');
      
      selectedSlots = [];
      updateUI();
      renderSlots();
    });
  });

  // Calendar Selection
  calendarDays.forEach(day => {
    day.addEventListener('click', () => {
      const date = day.getAttribute('data-date')!;
      if (date === currentSelectedDate) return;

      calendarDays.forEach(d => d.classList.remove('bg-brand-primary', 'text-black', 'selected'));
      day.classList.add('bg-brand-primary', 'text-black', 'selected');
      
      currentSelectedDate = date;
      selectedDateDisplay!.innerText = format(new Date(date), 'EEEE, MMM d');
      
      selectedSlots = [];
      updateUI();
      fetchAvailability(date);
    });
  });

  async function fetchAvailability(date: string) {
    slotContainer!.innerHTML = `
      <div class="col-span-2 flex flex-col items-center justify-center py-20 text-white/20">
        <div class="animate-spin mb-4 text-xl">◌</div>
        <p class="text-[10px] font-bold uppercase tracking-widest">Checking Availability...</p>
      </div>
    `;
    blackoutNotice!.classList.add('hidden');

    try {
      const res = await fetch(`/api/availability?courtId=${courtId}&date=${date}`);
      const data = await res.json();
      
      if (data.blackout) {
        blackoutNotice!.classList.remove('hidden');
        blackoutReason!.innerText = data.blackout.reason;
        slotContainer!.innerHTML = '';
        slots = [];
      } else {
        slots = data.slots;
        renderSlots();
      }
    } catch (err) {
      console.error('Failed to fetch availability:', err);
    }
  }

  function renderSlots() {
    if (!slots || slots.length === 0) {
      slotContainer!.innerHTML = '<p class="col-span-2 text-center text-white/20 text-xs py-12">No slots available for this date.</p>';
      return;
    }

    slotContainer!.innerHTML = slots.map(slot => {
      const isPrivate = currentMode === 'private';
      const canBook = isPrivate ? slot.allowExclusive : slot.allowOpen;
      const price = isPrivate ? slot.exclusivePrice : slot.openPrice;
      const isSelected = selectedSlots.some(s => s.id === slot.id);

      return `
        <button
          type="button"
          class="slot-btn p-3 rounded-xl border transition-all text-left group relative overflow-hidden flex flex-col justify-between
          ${isSelected 
            ? 'bg-brand-primary text-black border-brand-primary' 
            : (!canBook 
              ? 'bg-white/5 border-white/5 cursor-not-allowed booked' 
              : 'bg-brand-muted border-white/10 hover:border-brand-primary/50 cursor-pointer')}"
          data-id="${slot.id}"
          data-display="${slot.display}"
          data-price="${price}"
          ${!canBook ? 'disabled' : ''}
        >
          <div class="space-y-1 ${!canBook ? 'opacity-20' : ''}">
            <span class="text-[11px] font-bold block truncate uppercase tracking-tighter ${isSelected ? 'text-black' : 'text-white'} ${!canBook ? 'line-through' : ''}">
              ${slot.display}
            </span>
            <div class="flex items-center justify-between">
               <span class="text-[9px] font-bold ${isSelected ? 'text-black' : 'text-brand-primary'}">₱${price}</span>
               ${!isPrivate && slot.currentPlayers > 0 ? `
                 <span class="text-[8px] ${isSelected ? 'bg-black/10 text-black/60' : 'bg-white/5 text-white/40'} px-1 rounded uppercase font-bold">
                   ${slot.currentPlayers} Joined
                 </span>
               ` : ''}
            </div>
          </div>
          ${canBook ? `
            <div class="absolute top-1 right-1 ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity">
              <div class="w-3 h-3 rounded-full ${isSelected ? 'bg-black' : 'bg-brand-primary'} flex items-center justify-center">
                <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="${isSelected ? 'white' : 'black'}" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
            </div>
          ` : `
            <div class="absolute top-2 right-2">
              <span class="text-[7px] bg-red-500 text-white px-1.5 py-0.5 rounded-md uppercase font-bold shadow-sm">Booked</span>
            </div>
          `}
        </button>
      `;
    }).join('');

    slotContainer!.querySelectorAll('.slot-btn:not(.booked)').forEach(btn => {
      btn.addEventListener('click', () => handleSlotClick(btn as HTMLButtonElement));
    });
  }

  function handleSlotClick(btn: HTMLButtonElement) {
    const id = btn.getAttribute('data-id')!;
    const display = btn.getAttribute('data-display')!;
    const price = parseFloat(btn.getAttribute('data-price') || '0');
    
    const existingIndex = selectedSlots.findIndex(s => s.id === id);
    if (existingIndex > -1) {
      selectedSlots.splice(existingIndex, 1);
    } else {
      selectedSlots.push({ id, display, price });
    }
    
    updateUI();
    renderSlots();
  }

  function updateUI() {
    slotsInput.value = JSON.stringify(selectedSlots.map(s => s.id));
    
    const isCurrentlyOpen = currentMode === 'open';
    if (isCurrentlyOpen) playerCountField?.classList.remove('hidden');
    else playerCountField?.classList.add('hidden');

    const numPlayers = parseInt(playersInput.value) || 1;
    let total = 0;
    selectedSlots.forEach(s => {
      if (isCurrentlyOpen) total += s.price * numPlayers;
      else total += s.price;
    });

    totalPriceEl!.innerText = `₱${total.toFixed(2)}`;
    
    if (selectedSlots.length > 0) {
      selectedList!.innerHTML = selectedSlots.map(s => `
        <div class="flex items-center justify-between px-3 py-2 bg-white/5 rounded-xl border border-white/5 w-full">
          <span class="text-[10px] font-bold text-white uppercase">${s.display}</span>
          <span class="text-[10px] text-brand-primary font-bold">₱${s.price}</span>
        </div>
      `).join('');
      
      openCheckoutBtn.disabled = false;
      openCheckoutBtn.classList.remove('bg-white/10', 'text-white/40', 'cursor-not-allowed');
      openCheckoutBtn.classList.add('bg-brand-primary', 'text-black');
    } else {
      selectedList!.innerHTML = '<p class="text-xs text-white/20 italic text-center py-4 w-full">No slots selected yet...</p>';
      openCheckoutBtn.disabled = true;
      openCheckoutBtn.classList.add('bg-white/10', 'text-white/40', 'cursor-not-allowed');
      openCheckoutBtn.classList.remove('bg-brand-primary', 'text-black');
    }
  }

  playersInput?.addEventListener('input', updateUI);

  openCheckoutBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeCheckout?.addEventListener('click', () => modal?.classList.add('hidden'));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const is_open_play = currentMode === 'open';
    
    const payload = {
      ...data,
      player_count: parseInt(data.player_count as string) || 1,
      is_open_play,
      slots: selectedSlots.map(s => {
        const base = {
          is_open_play,
          price: s.price
        };
        if (s.id.includes('T')) {
          return {
            ...base,
            start_time: s.id,
            manual_slot_id: null,
            end_time: new Date(new Date(s.id).getTime() + 60 * 60 * 1000).toISOString()
          };
        }
        return {
          ...base,
          start_time: new Date(currentSelectedDate).toISOString(),
          manual_slot_id: s.id,
          end_time: new Date(currentSelectedDate).toISOString()
        }
      })
    };

    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Securing Court...';

    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await res.json();
      if (res.ok) {
        window.location.href = `/book/success?transactionId=${result.transaction_id}`;
      } else {
        throw new Error(result.error || 'Booking failed');
      }
    } catch (err: any) {
      errorMsg.innerText = err.message;
      errorMsg.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Confirm Reservation';
    }
  });

  // Initial Fetch
  fetchAvailability(currentSelectedDate);
</script>
